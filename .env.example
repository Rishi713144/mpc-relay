# Copy to `.env` for local development. Never commit a real `.env`.
# All values below are placeholders.

# ---------- Backend + indexer (main database) ----------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mpc_relay
JWT_SECRET=replace-with-a-long-random-secret

# ---------- Solana ----------
SOLANA_RPC_URL=https://api.devnet.solana.com
JUPITER_BASE_URL=https://lite-api.jup.ag/swap/v1

# Free public Yellowstone endpoint (required by the assignment).
YELLOWSTONE_ENDPOINT=https://solana-yellowstone-grpc.publicnode.com:443

# ---------- Backend -> MPC ----------
MPC_NODE_URLS=http://127.0.0.1:8001,http://127.0.0.1:8002,http://127.0.0.1:8003
MPC_SHARED_SECRET=replace-with-a-shared-secret

# ---------- Backend -> Indexer ----------
INDEXER_URL=http://127.0.0.1:9000

# ---------- Ports ----------
PORT=8080
INDEXER_PORT=9000

# ---------- MPC nodes ----------
# Each node must point at its OWN database. Run the three processes with
# different values of DATABASE_URL, MPC_NODE_ID and PORT (see README).
MPC_NODE_ID=1
MPC_DATABASE_URL=postgres://postgres:postgres@localhost:5432/mpc1
